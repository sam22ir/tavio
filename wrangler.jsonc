{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tavio",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": { "mode": "smart" },
  "triggers": { "crons": ["*/5 * * * *", "0 6 * * *"] },
  "hyperdrive": [
    {
      // Replace with the Hyperdrive config id after `wrangler hyperdrive create`.
      // Store the Postgres connection string with the Hyperdrive config, not in this file.
      "binding": "HYPERDRIVE",
      "id": "c513f2a82e374b7c87ec6fa07a7530ab"
    }
  ]
}
